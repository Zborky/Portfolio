<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PrijmyAVydavky.AddExpensePage"
             Title="Pridať výdavok">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="Názov výdavku" />
            <Entry x:Name="NameEntry" Placeholder="Napr. Potraviny" />

            <Label Text="Suma (€)" />
            <Entry x:Name="AmountEntry" Placeholder="Zadaj sumu" Keyboard="Numeric" />

            <Label Text="Kategória" />
            <Picker x:Name="CategoryPicker">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Jedlo</x:String>
                        <x:String>Bývanie</x:String>
                        <x:String>Zábava</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>

            <Label Text="Dátum" />
            <DatePicker x:Name="DatePicker" />

            <Button Text="Uložiť výdavok"
                    BackgroundColor="#2196F3"
                    TextColor="White"
                    Clicked="OnSaveClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
