<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:PrijmyAVydavky.Models"
             xmlns:charts="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
             x:Class="PrijmyAVydavky.MainPage"
             Title="Moje výdavky">

    <ScrollView>
        <StackLayout Padding="20" Spacing="15">

            <!-- Filter podľa kategórie -->
            <Label Text="Filtrovať podľa kategórie" />
            <Picker x:Name="CategoryFilterPicker" SelectedIndexChanged="OnCategoryFilterChanged">
                <Picker.Items>
                    <x:String>Všetko</x:String>
                    <x:String>Jedlo</x:String>
                    <x:String>Bývanie</x:String>
                    <x:String>Zábava</x:String>
                </Picker.Items>
            </Picker>

            

            

            <!-- Zoznam výdavkov -->
            <CollectionView x:Name="ExpensesCollectionView">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BorderColor="Gray" CornerRadius="10" Padding="10" Margin="5">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer
                                    NumberOfTapsRequired="1"
                                    CommandParameter="{Binding .}"
                                    Tapped="OnExpenseTapped" />
                            </Frame.GestureRecognizers>

                            <StackLayout>
                                <Label Text="{Binding Name}" FontSize="18" />
                                <Label Text="{Binding Category}" FontAttributes="Italic" />
                                <Label Text="{Binding Amount, StringFormat='Suma: {0:C}'}" />
                                <Label Text="{Binding Date, StringFormat='Dátum: {0:dd.MM.yyyy}'}" />
                            </StackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Výber mesiaca -->
            <Label Text="Vyber mesiac" />
            <Picker x:Name="MonthPicker" SelectedIndexChanged="OnMonthChanged">
                <Picker.Items>
                    <x:String>Aktuálny mesiac</x:String>
                    <x:String>Január</x:String>
                    <x:String>Február</x:String>
                    <x:String>Marec</x:String>
                    <x:String>Apríl</x:String>
                    <x:String>Máj</x:String>
                    <x:String>Jún</x:String>
                    <x:String>Júl</x:String>
                    <x:String>August</x:String>
                    <x:String>September</x:String>
                    <x:String>Október</x:String>
                    <x:String>November</x:String>
                    <x:String>December</x:String>
                </Picker.Items>
            </Picker>

            
            <Label Text="Príjem za mesiac (€)" />
            <Entry x:Name="IncomeEntry" Keyboard="Numeric" />
            <Button Text="Uložiť príjem" Clicked="OnSaveIncomeClicked" />

            <StackLayout x:Name="SummaryLayout" Padding="10" Spacing="5">
                <Label Text="Súhrn výdavkov" FontAttributes="Bold" FontSize="18" />
                <Label x:Name="FoodSummaryLabel" />
                <Label x:Name="HousingSummaryLabel" />
                <Label x:Name="EntertainmentSummaryLabel" />
                <Label x:Name="RemainingLabel" FontAttributes="Bold" />
            </StackLayout>

            
            <Button Text="Pridať výdavok"
                    BackgroundColor="#2196F3"
                    TextColor="White"
                    Clicked="OnAddExpenseClicked" />

        </StackLayout>
    </ScrollView>
</ContentPage>
